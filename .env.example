# Comma-separated local frontend origins. No secrets are required by this MVP.
APP_NAME=AI Drought Monitoring Platform
APP_VERSION=0.1.0
FRONTEND_ORIGINS=http://localhost:5173
# Optional Earth Engine-enabled Google Cloud project used for satellite exports.
# GEE_PROJECT=your-google-cloud-project-id
# For hosted deployments, set GEE_SERVICE_ACCOUNT_JSON to the full service-account
# key JSON as a protected environment secret. Never commit the key or expose it in
# frontend variables. The service account must be registered for Earth Engine use.
# GEE_SERVICE_ACCOUNT_JSON=
